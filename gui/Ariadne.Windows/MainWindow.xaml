<Window x:Class="Ariadne.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ariadne" Width="1200" Height="760" MinWidth="640" MinHeight="400"
        Background="{StaticResource WindowBackground}" Foreground="#E8EAED"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Workspace" />
        <ComboBox x:Name="WorkspacePicker" Grid.Column="1" DisplayMemberPath="Name"
                  SelectionChanged="WorkspacePicker_OnSelectionChanged" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Text="Window" />
        <ComboBox x:Name="WindowPicker" Grid.Column="4" DisplayMemberPath="Name"
                  SelectionChanged="WindowPicker_OnSelectionChanged" />
        <StackPanel Grid.Column="6" Orientation="Horizontal">
          <Button Padding="12,5" Margin="0,0,6,0" Click="NewTerminal_OnClick">New / split right</Button>
          <Button Padding="12,5" Margin="0,0,6,0" Click="SplitBelow_OnClick">Split below</Button>
          <Button x:Name="StashButton" Padding="12,5" Margin="0,0,6,0" Click="Stash_OnClick">Stash</Button>
          <Button Padding="12,5" Margin="0,0,6,0" Click="Palette_OnClick">Commands</Button>
          <Button Padding="12,5" Click="Reconnect_OnClick">Reconnect</Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" Padding="8,4">
      <Grid>
        <TextBlock x:Name="StatusText" Text="Starting…" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="AttentionButton" Padding="8,1" Margin="0,0,10,0" Click="Attention_OnClick">Alerts</Button>
          <TextBlock x:Name="RevisionText" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="PaneHost" Background="#0C0F13" />
  </DockPanel>
</Window>
