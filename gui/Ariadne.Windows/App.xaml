<Application x:Class="Ariadne.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#101318" />
    <SolidColorBrush x:Key="PanelBackground" Color="#171B22" />
    <SolidColorBrush x:Key="PaneBorder" Color="#343B48" />
    <SolidColorBrush x:Key="Accent" Color="#6EA8FE" />
  </Application.Resources>
</Application>
